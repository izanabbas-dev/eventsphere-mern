# Server port (the frontend expects 3000)
PORT=3000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere

# Secret key used to sign login tokens. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_string
# How long a login stays valid (e.g. 1d, 7d)
JWT_EXPIRE=7d

# Frontend address (used for CORS, socket.io and the reset password link)
CLIENT_URL=http://localhost:5173

# Email (leave SMTP_HOST empty to print emails in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EventSphere <no-reply@eventsphere.com>

# First admin (used by: npm run seed:admin)
ADMIN_NAME=EventSphere Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
